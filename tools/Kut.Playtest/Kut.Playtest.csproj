<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kut.Playtest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\packages\Kut.Core\Kut.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\content\levels\*.json" Link="content\levels\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\chapters.json" Link="content\chapters.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\collection\catalog.json" Link="content\collection\catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
